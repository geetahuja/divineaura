# Copy to .env.local and fill in. Never commit .env.local.
# Medusa backend (prod: https://api.divinesanatani.com)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Medusa Admin > Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Public URL of this storefront, used for canonical URLs, sitemap, OG (prod: https://divinesanatani.com)
NEXT_PUBLIC_SITE_URL=http://localhost:8000
# Region country code used when the URL has none. India-only store.
NEXT_PUBLIC_DEFAULT_REGION=in

# staging | live — read at runtime (restart, no rebuild). Live: analytics on, test payment page off.
# Staging banner, noindex and the password come from Nginx (deploy/server/site-mode.sh).
SITE_MODE=staging

# ── SEO + analytics (milestone 12) — all optional; analytics load only after cookie consent ──
# Read at runtime by /api/site-config (only when SITE_MODE=live): GA4_ID and META_PIXEL_ID.
# The NEXT_PUBLIC_ names below still work but are fixed at build time.
GA4_ID=
META_PIXEL_ID=
# Prefer verifying Search Console by a DNS TXT record (no rebuild); this tag needs a rebuild.
# Google Search Console → Settings → Ownership verification → HTML tag → the content="…" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 → Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Meta Events Manager → Data sources → your Pixel ID (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
