# Copy to .env.local and fill in. Never commit .env.local.
# Medusa backend (prod: https://api.divineaura.com)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Medusa Admin > Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Public URL of this storefront, used for canonical URLs, sitemap, OG (prod: https://divineaura.com)
NEXT_PUBLIC_SITE_URL=http://localhost:8000
# Region country code used when the URL has none. India-only store.
NEXT_PUBLIC_DEFAULT_REGION=in
# Shown in the footer; hidden when empty (prod: support@divineaura.com)
NEXT_PUBLIC_SUPPORT_EMAIL=
