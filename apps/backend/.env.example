# Copy to .env and fill in. Never commit .env.
# On the VPS this file is generated by deploy/server/setup-env.sh (fresh secrets).
# staging | live (deploy/GO-LIVE.md). Live refuses the test gateway, the test courier and
# console "delivery" of messages. Development behaves like staging; unset in production = live.
SITE_MODE=staging
# Public URL of this backend (prod: https://api.divinesanatani.com)
MEDUSA_BACKEND_URL=http://localhost:9000
# CORS: storefront origin (prod: https://divinesanatani.com)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
# Postgres. Dev: Neon direct (non-pooled) URL with ?sslmode=require. Prod: local Postgres on the VPS.
DATABASE_URL=
# Leave unset in dev (in-memory modules). Prod: redis://:<password>@127.0.0.1:6379
# (also switches events, workflows and locks to Redis so server + worker share them)
# REDIS_URL=
# VPS only: PM2 runs MEDUSA_WORKER_MODE=server (API + admin) and =worker (jobs) — see deploy/ecosystem.config.cjs
# MEDUSA_WORKER_MODE=shared
# Optional: domain for the admin session cookie (blank = api host only, recommended)
COOKIE_DOMAIN=
# false on the server: the migration seed creates no sample products
SEED_SAMPLE_PRODUCTS=true
# Uploaded files (product photos, certificates, Sacred Places images).
# Dev: static + http://localhost:9000/static
# Prod: /var/www/divineaura/uploads + https://api.divinesanatani.com/uploads (served by Nginx)
FILE_UPLOAD_DIR=static
FILE_BACKEND_URL=http://localhost:9000/static
# Payments (ARCHITECTURE.md §5.7). Each gateway loads only when its keys are set; customers
# see the ones ticked in Admin → Settings → Regions → India → Payment providers.
# Test gateway (staging/dev only — refuses to load when SITE_MODE=live):
TEST_PAYMENT_ENABLED=false
TEST_PAYMENT_WEBHOOK_SECRET=
# Razorpay: Dashboard → Account & Settings → API keys (rzp_test_… on staging, rzp_live_… live).
# Webhook: https://api.divinesanatani.com/hooks/payment/razorpay_razorpay, event "order.paid", same secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cash on Delivery confirm links (/confirm/<token>): signing secret + storefront base URL.
COD_CONFIRM_SECRET=
STOREFRONT_URL=http://localhost:8000
# Customer messages: console | sms | whatsapp | both (ARCHITECTURE.md §19; SMS/WhatsApp in milestone 9)
MESSAGING_CHANNEL=console
# Shipping (ARCHITECTURE.md §5.9). Couriers: Shiprocket (when EMAIL + PASSWORD are set),
# the manual courier (always; PIN lists in Admin → Shipping & couriers) and the test courier
# (staging/dev, needs TEST_COURIER_WEBHOOK_SECRET). The default is chosen in that admin page.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as in Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=
# Tracking webhook — TO VERIFY WITH A REAL TEST SHIPMENT before launch:
# the header Shiprocket sends the token in (default x-api-key) and the token you set
# in Shiprocket → Settings → Webhooks. URL: https://api.divinesanatani.com/hooks/shipping/shiprocket
SHIPROCKET_WEBHOOK_HEADER=x-api-key
SHIPROCKET_WEBHOOK_TOKEN=
TEST_COURIER_WEBHOOK_SECRET=
# Weight used when a product has no weight_g in its DivineAura details, and packaging weight
SHIPPING_DEFAULT_ITEM_WEIGHT_G=50
SHIPPING_PACKAGING_WEIGHT_G=50

# ── Messaging (ARCHITECTURE.md §19) — console until the accounts are ready ──
# MESSAGING_CHANNEL: console | sms | whatsapp | both (email is added whenever the customer has one)
# OTP_CHANNEL: sms | whatsapp | sms_then_whatsapp (resends after 30 s go by WhatsApp)
OTP_CHANNEL=sms
# Signs login codes and login tickets. Long random string; changing it invalidates open codes.
OTP_SECRET=
# SMS via MSG91 + DLT. TO VERIFY WITH A REAL ACCOUNT.
MSG91_AUTH_KEY=
SMS_SENDER_ID=
DLT_ENTITY_ID=
# event=MSG91 flow/DLT template id, comma separated, e.g. otp_login=1207...,order_placed=1207...
SMS_TEMPLATE_IDS=
# WhatsApp: WHATSAPP_PROVIDER=meta (Cloud API) or msg91. TO VERIFY WITH A REAL ACCOUNT.
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
MSG91_WHATSAPP_NUMBER=
# Optional: override approved template names, e.g. order_placed=order_confirmed_v2
WHATSAPP_TEMPLATE_NAMES=
# Email via Resend (console until RESEND_API_KEY is set). TO VERIFY WITH A REAL ACCOUNT.
RESEND_API_KEY=
EMAIL_FROM=DivineAura <noreply@divinesanatani.com>
EMAIL_REPLY_TO=support@divinesanatani.com

# ── Returns (milestone 10) ──
# Encrypts COD customers' UPI / bank details for refunds (deleted once the refund is paid).
# Long random string; keep it safe — changing it makes stored, unpaid details unreadable.
PAYOUT_ENCRYPTION_KEY=

# ── Backups (ARCHITECTURE.md §18, deploy/backup/RESTORE.md) ──
# Status file written by deploy/backup/backup.sh (STATUS_FILE in backup.conf). Unset in dev.
# Prod: /var/lib/divineaura-backup/status.json
BACKUP_STATUS_FILE=
# Who gets "backup failed / no backup in 48 h" emails (console until RESEND_API_KEY is set).
BACKUP_ALERT_EMAIL=
BACKUP_MAX_AGE_HOURS=48
